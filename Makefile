Version   := $(shell git describe --tags --dirty 2>/dev/null)
GitCommit := $(shell git rev-parse HEAD 2>/dev/null)
LDFLAGS   := "-s -w -X github.com/tschaefer/k8s/webhook/last-updated/internal/version.Version=$(Version) -X github.com/tschaefer/k8s/webhook/last-updated/internal/version.GitCommit=$(GitCommit)"
GOOS      := $(if $(GOOS),$(GOOS),linux)
GOARCH    := $(if $(GOARCH),$(GOARCH),amd64)

.PHONY: all
all: fmt lint dist

.PHONY: fmt
fmt:
	gofmt -l .

.PHONY: lint
lint:
	golangci-lint run

.PHONY: dist
dist:
	mkdir -p bin
	GOOS=$(GOOS) GOARCH=$(GOARCH) go build -o bin/last-updated-$(GOOS)-$(GOARCH) -ldflags $(LDFLAGS)

.PHONY: test
test:
	go test -count=1 -v ./internal/...

.PHONY: test-coverage
test-coverage:
	go test -covermode=atomic -p=4 -count=1 -v -coverprofile=coverage.out ./internal/...

.PHONY: clean
clean:
	rm -rf bin/ coverage/ coverage.out install.yaml

.PHONY: manifest
manifest:
	rm -f manifests/install.yaml
	echo "# Autogenerated: $(shell date --iso-8601=seconds)" > install.yaml
	echo "# Commit: $(GitCommit)" >> install.yaml
	echo "# Tag: $(Version)" >> install.yaml
	echo "#" >> install.yaml
	echo "# Copyright (c) Tobias Schäfer. All rights reserved." >> install.yaml
	echo "# Licensed under the MIT license, see LICENSE in the project root for details." >> install.yaml
	cat manifests/namespace.yaml manifests/serviceaccount.yaml \
		manifests/issuer.yaml manifests/certificate.yaml \
		manifests/configmap.yaml manifests/deployment.yaml \
		manifests/service.yaml manifests/mutating-webhook-configuration.yaml \
		manifests/servicemonitor.yaml manifests/grafana-dashboard.yaml >> install.yaml
	sed -i 's/{{VERSION}}/$(Version)/g' install.yaml
